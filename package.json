{
  "name": "smart-pantry-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:web",
    "build": "npm run build:web",
    "preview": "npm run preview:web",
    "dev:web": "vite --host",
    "build:web": "vite build",
    "budget:web": "node scripts/check-build-budget.mjs",
    "preview:web": "vite preview",
    "dev:api": "cd backend_python && python3 -m uvicorn app.main:app --reload --port 3001",
    "check:local-env": "node scripts/check-local-env.mjs",
    "check:db-schema": "cd backend_python && python3 check_schema.py",
    "check:seo": "node scripts/check-seo-surface.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "lint": "eslint",
    "clean": "rm -rf dist .next",
    "dev:clean": "npm run clean && npm run dev",
    "dev:all": "concurrently \"npm run dev:web\" \"npm run dev:api\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.27.5",
    "i18next": "^23.15.1",
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^15.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/vite": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^5.1.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.0.5"
  }
}
