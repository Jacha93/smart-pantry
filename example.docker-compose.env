# ============================================
# Smart Pantry - Frontend Environment Variables (Vite)
# ============================================
# Diese Datei ist NUR für das Frontend (Vite)
# Backend-Variablen gehören in: backend_python/.env
# ============================================

# ============================================
# Docker Port-Konfiguration (für Docker Compose)
# ============================================
# WICHTIG: Die Container-Ports sind hardcoded
# Marketing: 3000
# App-Frontend: 3000, Backend: 3001
MARKETING_PORT=3000
APP_PORT=3001

# ============================================
# Frontend-Konfiguration (Vite)
# ============================================
# API-URL für das Backend
# In Development: Vite leitet /api/* Requests automatisch zum Backend weiter
# In Production: Setze die vollständige Backend-URL
# Standard: http://127.0.0.1:3001 (wird über Vite Proxy verwendet)
VITE_API_URL=http://127.0.0.1:3001

# Authentication Configuration
# Setze auf 'true' um Auth komplett zu deaktivieren (nur für Testing)
# Standard: Auth ist aktiviert (nicht setzen oder 'false')
VITE_AUTH_DISABLED=false

# Mock-Auth für lokale Entwicklung ohne Datenbank
# Setze auf 'true' um Mock-Auth zu verwenden (für Testing ohne Backend)
# In Produktion immer auf false setzen!
VITE_USE_MOCK_AUTH=false

# ============================================
# Google AdSense Configuration (Optional)
# ============================================
# Werbung wird nur für Free Tier User angezeigt
# Basic und Pro User haben eine werbefreie Erfahrung
#
# Setup-Anleitung:
# 1. Erstelle einen Google AdSense Account: https://www.google.com/adsense/
# 2. Verifiziere deine Website
# 3. Erstelle Ad Units in verschiedenen Formaten:
#    - Rectangle (300x250): Für Seitenleisten und zwischen Content
#    - Horizontal Banner (728x90): Für oberen/unteren Bereich
#    - Vertical Banner (160x600): Für Sidebar (optional)
# 4. Kopiere die Ad Unit IDs und füge sie hier ein
#
# Publisher ID Format: ca-pub-XXXXXXXXXX (nur die Zahlen nach "ca-pub-")
# Ad Slot ID Format: YYYYYYYYYY (nur die Zahlen nach dem Bindestrich)
# Beispiel: ca-pub-1234567890-9876543210
#          Publisher ID: 1234567890
#          Ad Slot ID: 9876543210
VITE_ADSENSE_PUBLISHER_ID=your_publisher_id_here

# Rectangle Ad (300x250) - Für Groceries, Shopping List, zwischen Rezepten
VITE_ADSENSE_AD_SLOT_RECTANGLE=your_rectangle_slot_id_here

# Horizontal Banner (728x90) - Für Recipes Page, unter Content
VITE_ADSENSE_AD_SLOT_HORIZONTAL=your_horizontal_slot_id_here

# Vertical Banner (160x600) - Für Sidebar (optional, aktuell nicht verwendet)
VITE_ADSENSE_AD_SLOT_VERTICAL=your_vertical_slot_id_here

# Dev-Mode: Zeige Ads für alle User (für Testing)
# Setze auf true um Ads auch für Paid User zu sehen (nur für Development)
VITE_SHOW_ADS_FOR_ALL=false

# ============================================
# WICHTIGE HINWEISE
# ============================================
# FRONTEND (Vite):
# - Diese Datei enthält NUR Frontend-Variablen (VITE_*)
# - Vite liest nur Variablen die mit VITE_ beginnen
# - Kopiere diese Datei zu .env im Hauptverzeichnis
#
# BACKEND:
# - Backend-Variablen gehören in: backend_python/.env
# - Backend liest seine .env automatisch aus backend_python/.env
# - Siehe: backend_python/example.env für Backend-Variablen
#
# DOCKER COMPOSE:
# - Docker Compose liest .env aus dem Hauptverzeichnis
# - Für Marketing/App die passenden Host-Ports setzen (siehe oben)
# - Backend-Variablen werden an Backend-Container weitergegeben
# - Für lokale Entwicklung: Nutze separate .env Dateien
# - Für Docker: Kombiniere beide in .env im Hauptverzeichnis (optional)
#
# HOSTING:
# - Frontend und Backend werden oft getrennt deployed
# - Frontend: Nur VITE_* Variablen in Hosting-Environment setzen
# - Backend: Nur Backend-Variablen in Hosting-Environment setzen
# - Getrennte .env Dateien sind für Hosting ideal





# ============================================
# Smart Pantry - Backend Environment Variables (Python/FastAPI)
# ============================================
# Diese Datei ist NUR für das Backend
# Frontend-Variablen gehören in: ../.env (Hauptverzeichnis)
# ============================================

# ============================================
# Datenbank-Konfiguration
# ============================================
# PostgreSQL Verbindungsstring
# Format: postgresql://user:password@host:port/database
# Für Supabase: Verwende den Transaction Mode String
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/smart_pantry

# ============================================
# Security-Keys (MUSS gesetzt werden!)
# ============================================
# JWT Secret für Token-Signierung
# Generiere mit: openssl rand -hex 32
# WICHTIG: Muss mindestens 32 Zeichen lang sein!
# In Production wird ein schwaches Secret abgelehnt
JWT_SECRET=your_jwt_secret_here_generate_secure_random_string

# Refresh Token TTL in Millisekunden (30 Tage = 2592000000)
REFRESH_TOKEN_TTL_MS=2592000000

# ============================================
# Environment Configuration
# ============================================
# Setze auf "production" für Production-Umgebung
# In Production: Strengere Security, generische Error Messages
ENVIRONMENT=development

# ============================================
# CORS Configuration (für Production)
# ============================================
# Erlaubte Origins für CORS (komma-separiert)
# Beispiel: ALLOWED_ORIGINS=https://example.com,https://www.example.com
# In Development: localhost wird automatisch erlaubt
ALLOWED_ORIGINS=

# ============================================
# Quota Configuration (MUSS gesetzt werden!)
# ============================================
# Quota Reset Interval in Millisekunden (30 Tage = 2592000000)
QUOTA_RESET_INTERVAL_MS=2592000000

# LLM Token Costs (in Credits pro 1000 Tokens)
LLM_TOKEN_COST_CHAT=100
LLM_TOKEN_COST_TRANSLATION=50
LLM_TOKEN_COST_ANALYZE=200

# Recipe Call Costs (in Credits pro Call)
RECIPE_CALL_COST_ANALYZE=1

# ============================================
# API Keys (Optional)
# ============================================
# Gemini API Key für Foto-Analyse und Chat
# Ohne Key werden Stub-Daten verwendet
# Erstelle Key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Spoonacular API Key für Rezeptvorschläge
# Ohne Key werden Stub-Daten verwendet
# Erstelle Key: https://spoonacular.com/food-api
SPOONACULAR_API_KEY=

# GitHub Token für Issue-Erstellung (Optional)
# Erstelle Token: https://github.com/settings/tokens
GITHUB_TOKEN=

# ============================================
# Admin Account Configuration (Optional)
# ============================================
# Der Admin-Account wird automatisch beim Server-Start erstellt
# Falls nicht gesetzt, werden Standard-Werte verwendet
# Ändere diese Werte für Production!
ADMIN_USER_EMAIL=your_admin_email@example.com
ADMIN_USER_NAME=your_admin_name
ADMIN_USER_PASSWORD=your_secure_admin_password_here
ADMIN_USER_FULLNAME=Your Admin Full Name
ADMIN_USER_USERNAME=your_admin_username

# ============================================
# Backend Port (Optional)
# ============================================
# Port auf dem das Backend läuft (Standard: 3001)
# Wird nur für lokale Entwicklung benötigt
# In Docker wird dieser Wert überschrieben
BACKEND_PORT=3001

# ============================================
# WICHTIGE HINWEISE
# ============================================
# BACKEND (Python/FastAPI):
# - Diese Datei enthält NUR Backend-Variablen
# - Backend lädt .env automatisch aus backend_python/.env
# - Kopiere diese Datei zu backend_python/.env
#
# FRONTEND:
# - Frontend-Variablen gehören in: ../.env (Hauptverzeichnis)
# - Frontend liest nur VITE_* Variablen
# - Siehe: ../example.env für Frontend-Variablen
#
# DOCKER COMPOSE:
# - Docker Compose liest .env aus dem Hauptverzeichnis
# - Marketing und App laufen als getrennte Container
# - Backend-Variablen werden an Backend-Container weitergegeben
# - Für lokale Entwicklung: Nutze backend_python/.env
# - Für Docker: Variablen können auch in .env im Hauptverzeichnis sein
#
# HOSTING:
# - Backend wird oft getrennt vom Frontend deployed
# - Setze Backend-Variablen in Hosting-Environment
# - Getrennte .env Dateien sind für Hosting ideal
#
# SIEHE AUCH:
# - ../ENV_SETUP.md für vollständige Dokumentation
